# ========================================================
# PENGATURAN LINGKUNGAN AWS (EC2 / LIGHTSAIL / APP RUNNER)
# ========================================================

APP_NAME="SI Kepegawaian Tamalate"
APP_ENV=production
# Ganti dengan key dari: php artisan key:generate --show
APP_KEY=base64:4YAIZ+lxuXrTb7wjHeAA9WvlW2b5smipOWaqmwOL8VM=
APP_DEBUG=false
# Ganti dengan IP Publik EC2 atau nama domain Anda (misal: http://13.250.xxx.xxx atau https://kepegawaian.tamalate.id)
APP_URL=http://localhost
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --------------------------------------------------------
# PILIHAN DATABASE DI AWS:
# --------------------------------------------------------

# SKENARIO 1: Docker Compose MySQL di AWS EC2 / Lightsail (Rekomendasi Hemat Biaya)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=si_kepegawaian_tamalate
DB_USERNAME=tamalate_user
DB_PASSWORD=GantiPasswordKuatDB2026!
DB_ROOT_PASSWORD=GantiPasswordRootKuat2026!

# SKENARIO 2: AWS RDS MySQL (Managed Database AWS)
# DB_CONNECTION=mysql
# DB_HOST=database-tamalate.cxxxxx.ap-southeast-1.rds.amazonaws.com
# DB_PORT=3306
# DB_DATABASE=si_kepegawaian_tamalate
# DB_USERNAME=admin
# DB_PASSWORD=PasswordRDSKuat2026!

# SKENARIO 3: SQLite (Tanpa MySQL, untuk uji coba instan)
# DB_CONNECTION=sqlite

# --------------------------------------------------------
# INISIALISASI DATABASE OTOMATIS SAAT DEPLOY:
# --------------------------------------------------------
RUN_MIGRATIONS=true
# Set true pada deploy pertama kali untuk mengisi role dan data demo, lalu ubah ke false setelahnya
RUN_SEEDER=true

# --------------------------------------------------------
# SESI & CACHE
# --------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --------------------------------------------------------
# OPSIONAL: SIMPAN BERKAS DI AWS S3 (Jika diperlukan)
# --------------------------------------------------------
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=tamalate-storage
# AWS_USE_PATH_STYLE_ENDPOINT=false

