# ========================================================
# PENGATURAN LINGKUNGAN MICROSOFT AZURE
# (Azure App Service / Azure Container Apps / Azure VM)
# ========================================================

APP_NAME="SI Kepegawaian Tamalate"
APP_ENV=production
# Ganti dengan key dari: php artisan key:generate --show
APP_KEY=base64:4YAIZ+lxuXrTb7wjHeAA9WvlW2b5smipOWaqmwOL8VM=
APP_DEBUG=false

# Ganti dengan URL Azure Anda (misal: https://tamalate-app.azurewebsites.net atau domain kustom)
APP_URL=https://tamalate-app.azurewebsites.net
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --------------------------------------------------------
# PILIHAN DATABASE DI AZURE:
# --------------------------------------------------------

# SKENARIO 1: Azure Database for MySQL - Flexible Server (Rekomendasi Production Azure)
DB_CONNECTION=mysql
DB_HOST=tamalate-db.mysql.database.azure.com
DB_PORT=3306
DB_DATABASE=si_kepegawaian_tamalate
DB_USERNAME=tamalateadmin
DB_PASSWORD=PasswordKuatAzure2026!
# Opsional jika SSL aktif di Flexible Server:
# MYSQL_ATTR_SSL_CA=/var/www/html/DigiCertGlobalRootG2.crt.pem

# SKENARIO 2: Docker Compose MySQL di Azure Virtual Machine (Paling Hemat Biaya)
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=si_kepegawaian_tamalate
# DB_USERNAME=tamalate_user
# DB_PASSWORD=tamalate_secret_2026
# DB_ROOT_PASSWORD=root_secret_2026

# SKENARIO 3: SQLite (Tanpa MySQL, untuk uji coba instan di Azure)
# DB_CONNECTION=sqlite

# --------------------------------------------------------
# INISIALISASI DATABASE OTOMATIS SAAT DEPLOY:
# --------------------------------------------------------
RUN_MIGRATIONS=true
# Set true pada deploy pertama kali untuk mengisi role dan data demo, lalu ubah ke false
RUN_SEEDER=true

# --------------------------------------------------------
# SESI & CACHE
# --------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --------------------------------------------------------
# PENGATURAN PORT UNTUK AZURE APP SERVICE:
# --------------------------------------------------------
WEBSITES_PORT=80
WEBSITES_ENABLE_APP_SERVICE_STORAGE=true

